@using BrickForge.Core
@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="viewport" @ref="_host"></div>

@code {
    [Parameter, EditorRequired] public Editor Editor { get; set; } = default!;

    private ElementReference _host;
    private IJSObjectReference? _module;
    private IJSObjectReference? _viewport;
    private DotNetObjectReference<Viewport>? _self;
    private Editor? _subscribed;

    protected override void OnParametersSet()
    {
        if (_subscribed == Editor) return;
        if (_subscribed is not null) _subscribed.Changed -= OnEditorChanged;
        Editor.Changed += OnEditorChanged;
        _subscribed = Editor;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        var build = Editor.Build;
        _self = DotNetObjectReference.Create(this);
        _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/viewport.js");
        _viewport = await _module.InvokeAsync<IJSObjectReference>("createViewport", _host, new
        {
            baseplateWidth = build.Baseplate.WidthStuds,
            baseplateDepth = build.Baseplate.DepthStuds,
            plateHeight = LegoUnits.PlateHeight,
            studDiameter = LegoUnits.StudDiameter,
            studHeight = LegoUnits.StudHeight,
            partInset = LegoUnits.PartInset,
            parts = PartCatalog.All.Select(p => new { p.Id, p.Width, p.Depth, p.HeightPlates, p.HasStuds }),
            colors = Palette.All.Select(c => new { c.Id, c.Hex, c.IsTransparent }),
        }, _self);

        await SendAsync(new BuildChange([.. build.Parts], []));
    }

    /// <summary>
    /// Forwards every editor change to JS. Each call is dispatched synchronously, so JS receives
    /// changes in the order the editor raised them even though we don't await here.
    /// </summary>
    private void OnEditorChanged(BuildChange change) => _ = SendAsync(change);

    private async Task SendAsync(BuildChange change)
    {
        if (_viewport is null) return;
        try
        {
            await _viewport.InvokeVoidAsync("update", new
            {
                added = Flatten(change.Added),
                removed = change.Removed,
                baseplate = change.Baseplate is { } plate ? new { width = plate.WidthStuds, depth = plate.DepthStuds } : null,
                tool = new
                {
                    mode = Editor.Mode.ToString().ToLowerInvariant(),
                    ghost = FlattenGroup(Editor.Ghost),
                    ghostSize = new[] { Editor.Ghost.SizeX, Editor.Ghost.SizeY, Editor.Ghost.SizeZ },
                    selection = Editor.Selection.ToArray(),
                },
            });
        }
        catch (JSDisconnectedException)
        {
            // Page is going away.
        }
    }

    // ---- input from JS ----------------------------------------------------------------------

    public sealed record CellDto(int X, int Y, int Z);

    [JSInvokable]
    public bool CanPlace(int x, int y, int z) => Editor.CanPlaceAt(new GridPos(x, y, z));

    [JSInvokable]
    public void Click(CellDto? cell, int? partId, bool alt, bool shift, bool ctrl)
    {
        switch (partId)
        {
            case { } id when alt:
                Editor.Eyedrop(id);
                break;
            case { } id when shift:
                Editor.PickUp(id);
                break;
            case var id when Editor.Mode == EditorMode.Select:
                Editor.Select(id, additive: ctrl);
                break;
            case { } id when Editor.Mode == EditorMode.Paint:
                Editor.Paint(id);
                break;
            default:
                if (cell is not null) Editor.PlaceAt(new GridPos(cell.X, cell.Y, cell.Z));
                break;
        }
    }

    [JSInvokable]
    public void BoxSelect(int[] partIds, bool additive) => Editor.SelectMany(partIds, additive);

    [JSInvokable]
    public void Remove(int partId) => Editor.Remove(partId);

    /// <param name="key">Lower-cased <c>KeyboardEvent.key</c>.</param>
    [JSInvokable]
    public void Key(string key, bool ctrl, bool shift, int? hoveredPartId)
    {
        switch (key, ctrl)
        {
            case ("z", true) when shift: Editor.Redo(); break;
            case ("z", true): Editor.Undo(); break;
            case ("y", true): Editor.Redo(); break;
            case ("r", false): Editor.Rotate(shift ? -1 : 1); break;
            case ("c", true): Editor.Copy(); break;
            case ("x", true): Editor.Cut(); break;
            case ("v", true): Editor.Paste(); break;
            case ("a", true): Editor.SelectAll(); break;
            case ("b", false): Editor.SetMode(EditorMode.Build); break;
            case ("p", false): Editor.SetMode(EditorMode.Paint); break;
            case ("s", false): Editor.SetMode(EditorMode.Select); break;
            case ("escape", false): Editor.Cancel(); break;
            case ("e", false) when hoveredPartId is { } id: Editor.Eyedrop(id); break;
            // An explicit selection wins over whatever happens to be under the cursor.
            case ("delete" or "backspace", false) when Editor.Selection.Count > 0: Editor.DeleteSelection(); break;
            case ("delete" or "backspace", false) when hoveredPartId is { } id: Editor.Remove(id); break;
        }
    }

    /// <summary>A group as a flat array of <c>[catalogIndex, dx, dy, dz, rotation, colorId]</c> per part.</summary>
    private static int[] FlattenGroup(PartGroup group)
    {
        var flat = new int[group.Parts.Count * 6];
        for (var i = 0; i < group.Parts.Count; i++)
        {
            var p = group.Parts[i];
            var o = i * 6;
            flat[o] = CatalogIndex[p.Part];
            flat[o + 1] = p.Offset.X;
            flat[o + 2] = p.Offset.Y;
            flat[o + 3] = p.Offset.Z;
            flat[o + 4] = (int)p.Rotation;
            flat[o + 5] = p.ColorId;
        }
        return flat;
    }

    private static readonly Dictionary<PartType, int> CatalogIndex =
        PartCatalog.All.Select((part, i) => (part, i)).ToDictionary(x => x.part, x => x.i);

    /// <summary>
    /// Parts as one flat array of <c>[id, catalogIndex, x, y, z, rotation, colorId]</c> per part.
    /// Loading a big build sends thousands of parts; plain ints marshal far faster than objects.
    /// </summary>
    private static int[] Flatten(IReadOnlyList<PlacedPart> parts)
    {
        var flat = new int[parts.Count * 7];
        for (var i = 0; i < parts.Count; i++)
        {
            var p = parts[i];
            var o = i * 7;
            flat[o] = p.Id;
            flat[o + 1] = CatalogIndex[p.Part];
            flat[o + 2] = p.Position.X;
            flat[o + 3] = p.Position.Y;
            flat[o + 4] = p.Position.Z;
            flat[o + 5] = (int)p.Rotation;
            flat[o + 6] = p.ColorId;
        }
        return flat;
    }

    public async ValueTask DisposeAsync()
    {
        if (_subscribed is not null) _subscribed.Changed -= OnEditorChanged;
        try
        {
            if (_viewport is not null)
            {
                await _viewport.InvokeVoidAsync("dispose");
                await _viewport.DisposeAsync();
            }
            if (_module is not null) await _module.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
            // Page is going away; nothing to clean up.
        }
        _self?.Dispose();
    }
}
