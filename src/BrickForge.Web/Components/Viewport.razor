@using BrickForge.Core
@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="viewport" @ref="_host"></div>

@code {
    [Parameter, EditorRequired] public Build Build { get; set; } = default!;
    [Parameter, EditorRequired] public PartType Part { get; set; } = default!;
    [Parameter, EditorRequired] public BrickColor Color { get; set; } = default!;
    [Parameter] public Rotation Rotation { get; set; }
    [Parameter] public EventCallback BuildChanged { get; set; }

    private ElementReference _host;
    private IJSObjectReference? _module;
    private IJSObjectReference? _viewport;
    private DotNetObjectReference<Viewport>? _self;
    private (PartType, BrickColor, Rotation)? _sentTool;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _self = DotNetObjectReference.Create(this);
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/viewport.js");
            _viewport = await _module.InvokeAsync<IJSObjectReference>("createViewport", _host, new
            {
                baseplateWidth = Build.Baseplate.WidthStuds,
                baseplateDepth = Build.Baseplate.DepthStuds,
                plateHeight = LegoUnits.PlateHeight,
                studDiameter = LegoUnits.StudDiameter,
                studHeight = LegoUnits.StudHeight,
                partInset = LegoUnits.PartInset,
                parts = PartCatalog.All.Select(p => new { p.Id, p.Width, p.Depth, p.HeightPlates, p.HasStuds }),
                colors = Palette.All.Select(c => new { c.Id, c.Hex, c.IsTransparent }),
            }, _self);
            await _viewport.InvokeVoidAsync("addParts", Build.Parts.Select(ToDto).ToList());
        }

        await SyncToolAsync();
    }

    private async Task SyncToolAsync()
    {
        if (_viewport is null || _sentTool == (Part, Color, Rotation)) return;
        _sentTool = (Part, Color, Rotation);
        await _viewport.InvokeVoidAsync("setTool", new { partId = Part.Id, colorId = Color.Id, rotation = (int)Rotation });
    }

    [JSInvokable]
    public bool CanPlace(int x, int y, int z) =>
        Build.Check(Part, new GridPos(x, y, z), Rotation) == PlacementError.None;

    [JSInvokable]
    public async Task Place(int x, int y, int z)
    {
        var result = Build.TryPlace(Part, new GridPos(x, y, z), Rotation, Color.Id);
        if (!result.Success || _viewport is null) return;

        // A bare array would bind to InvokeVoidAsync's params object[] and be spread into separate arguments.
        await _viewport.InvokeVoidAsync("addParts", new List<PartDto> { ToDto(result.Part!) });
        await BuildChanged.InvokeAsync();
    }

    [JSInvokable]
    public async Task Remove(int partId)
    {
        if (!Build.Remove(partId) || _viewport is null) return;

        await _viewport.InvokeVoidAsync("removeParts", new List<int> { partId });
        await BuildChanged.InvokeAsync();
    }

    private sealed record PartDto(int Id, string PartId, int X, int Y, int Z, int Rotation, int ColorId);

    private static PartDto ToDto(PlacedPart p) =>
        new(p.Id, p.Part.Id, p.Position.X, p.Position.Y, p.Position.Z, (int)p.Rotation, p.ColorId);

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_viewport is not null)
            {
                await _viewport.InvokeVoidAsync("dispose");
                await _viewport.DisposeAsync();
            }
            if (_module is not null) await _module.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
            // Page is going away; nothing to clean up.
        }
        _self?.Dispose();
    }
}
