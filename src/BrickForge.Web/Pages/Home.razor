@page "/"
@using System.Globalization
@using BrickForge.Core
@using BrickForge.Web.Components
@using BrickForge.Web.Services
@implements IDisposable
@inject BuildStorage Storage

<PageTitle>BrickForge</PageTitle>

<div class="workspace">
    <aside class="panel">
        <header class="panel-header">
            <h1>BrickForge</h1>
            <div class="icon-buttons">
                <button title="Undo (Ctrl+Z)" disabled="@(!_editor.CanUndo)" @onclick="_editor.Undo">↶</button>
                <button title="Redo (Ctrl+Y)" disabled="@(!_editor.CanRedo)" @onclick="_editor.Redo">↷</button>
            </div>
        </header>

        <div class="file-row">
            <button title="Start an empty build (undoable)" @onclick="() => OpenSizeDialog(SizeDialog.New)">New</button>
            <label class="file-button" title="Load a .json build file (undoable)">
                Import
                <InputFile accept=".json,application/json" OnChange="ImportAsync" />
            </label>
            <button title="Download this build as a .json file" @onclick="ExportAsync">Export</button>
        </div>
        <div class="baseplate-row">
            <span>Baseplate <strong>@_editor.Build.Baseplate</strong></span>
            <button title="Change the baseplate size (undoable)" @onclick="() => OpenSizeDialog(SizeDialog.Resize)">Resize</button>
        </div>
        @if (_notice is { } notice)
        {
            <p class="notice @(notice.IsError ? "error" : null)">@notice.Text</p>
        }

        <div class="toolbar">
            <div class="segmented">
                <button class="@Active(_editor.Mode == EditorMode.Build)" title="Build (B)"
                        @onclick="() => _editor.SetMode(EditorMode.Build)">Build</button>
                <button class="@Active(_editor.Mode == EditorMode.Paint)" title="Paint (P)"
                        @onclick="() => _editor.SetMode(EditorMode.Paint)">Paint</button>
                <button class="@Active(_editor.Mode == EditorMode.Select)" title="Select (S)"
                        @onclick="() => _editor.SetMode(EditorMode.Select)">Select</button>
            </div>
            <button class="rotate" title="Rotate (R / Shift+R)" @onclick="() => _editor.Rotate(1)">
                ⟳ @((int)_editor.Rotation * 90)°
            </button>
        </div>

        <p class="status">
            @if (_editor.Held is { IsPaste: true, Label: { } label } placing)
            {
                <span class="carrying">Placing @label (@Parts(placing.Group.Parts.Count)) — click to stamp, R to rotate, Esc to stop</span>
            }
            else if (_editor.Held is { IsPaste: true } paste)
            {
                <span class="carrying">Pasting @Parts(paste.Group.Parts.Count) — click to stamp, R to rotate, Esc to stop</span>
            }
            else if (_editor.Held is { } moving)
            {
                <span class="carrying">Moving @Parts(moving.Moving.Count) — click to drop, R to rotate, Esc to cancel</span>
            }
            else if (_editor.Mode == EditorMode.Paint)
            {
                <span>Click parts to paint them <strong>@_editor.Color.Name</strong>@(_editor.Selection.Count > 1 ? " (a selected part paints the whole selection)" : "")</span>
            }
            else if (_editor.Mode == EditorMode.Select)
            {
                <span>Click to select · Ctrl+click to add · drag to box-select</span>
            }
            else
            {
                <span>@_editor.Part.Name · @_editor.Color.Name</span>
            }
        </p>

        <div class="selection-bar">
            <span>@(_editor.Selection.Count == 0 ? "Nothing selected" : $"{Parts(_editor.Selection.Count)} selected")</span>
            <div class="selection-actions">
                <button title="Copy (Ctrl+C)" disabled="@(_editor.Selection.Count == 0)" @onclick="_editor.Copy">Copy</button>
                <button title="Cut (Ctrl+X)" disabled="@(_editor.Selection.Count == 0)" @onclick="_editor.Cut">Cut</button>
                <button title="Paste (Ctrl+V)" disabled="@(!_editor.HasClipboard)" @onclick="_editor.Paste">Paste</button>
                <button title="Delete selection (Del)" disabled="@(_editor.Selection.Count == 0)" @onclick="_editor.DeleteSelection">Delete</button>
            </div>
            <button class="save-component" disabled="@(_editor.Selection.Count == 0)"
                    title="Save the selected parts as a reusable component" @onclick="OpenSaveComponent">
                Save as component…
            </button>
        </div>

        <div class="section-header">
            <h2>Components</h2>
            <div class="section-actions">
                <label class="file-button" title="Add components from a .json library file">
                    Import
                    <InputFile accept=".json,application/json" OnChange="ImportComponentsAsync" />
                </label>
                <button title="Download the component library as a .json file" disabled="@(_library.Components.Count == 0)"
                        @onclick="ExportComponentsAsync">Export</button>
            </div>
        </div>
        @if (_library.Components.Count == 0)
        {
            <p class="empty-hint">Select some parts and choose <em>Save as component…</em> to reuse them here.</p>
        }
        <div class="component-grid">
            @foreach (var component in _library.Components)
            {
                <div class="component-card @Active(_editor.Held?.Label == component.Name && _editor.Held.IsPaste)"
                     draggable="true" data-brickforge-drag title="Click or drag to place @component.Name"
                     @onclick="() => _editor.Hold(component.Group, component.Name)"
                     @ondragstart="() => _editor.Hold(component.Group, component.Name)">
                    @if (_thumbnails.TryGetValue(component.Group, out var thumbnail))
                    {
                        <img src="@thumbnail" alt="" draggable="false" />
                    }
                    else
                    {
                        <div class="thumbnail-placeholder"></div>
                    }
                    <span class="component-name">@component.Name</span>
                    <span class="component-count">@Parts(component.Group.Parts.Count)</span>
                    @if (_confirmDeleteId == component.Id)
                    {
                        <div class="component-confirm" @onclick:stopPropagation>
                            <span>Delete?</span>
                            <button @onclick="() => DeleteComponent(component.Id)">Yes</button>
                            <button @onclick="() => _confirmDeleteId = null">No</button>
                        </div>
                    }
                    else
                    {
                        <div class="component-actions" @onclick:stopPropagation>
                            <button title="Rename" @onclick="() => OpenRenameComponent(component)">✎</button>
                            <button title="Delete" @onclick="() => _confirmDeleteId = component.Id">✕</button>
                        </div>
                    }
                </div>
            }
        </div>

        @foreach (var group in PartCatalog.All.GroupBy(p => p.Kind))
        {
            <h2>@(group.Key)s</h2>
            <div class="part-grid">
                @foreach (var part in group)
                {
                    <button class="part @Active(part == _editor.Part && _editor.Mode == EditorMode.Build && _editor.Held is null)"
                            title="@part.Name — click or drag onto the baseplate" @onclick="() => _editor.SelectPart(part)"
                            draggable="true" data-brickforge-drag @ondragstart="() => _editor.SelectPart(part)">
                        @Footprint(part)
                        <span>@part.Width×@part.Depth</span>
                    </button>
                }
            </div>
        }

        <h2>Color</h2>
        <div class="swatches">
            @foreach (var color in Palette.All)
            {
                <button class="swatch @Active(color == _editor.Color) @(color.IsTransparent ? "trans" : null)"
                        style="--swatch: @color.Hex" title="@color.Name" @onclick="() => _editor.SelectColor(color)"></button>
            }
        </div>

        <p class="stats">
            @_editor.Build.Parts.Count parts ·
            <span class="@(_saveState == SaveState.Failed ? "error" : null)">@SaveStateText</span>
        </p>
    </aside>

    <div class="stage">
        <Viewport Editor="_editor" @ref="_viewport" />
        <div class="controls-bar">
            @foreach (var (keys, action) in Controls)
            {
                <span><kbd>@keys</kbd> @action</span>
            }
        </div>
    </div>
</div>

@switch (_sizeDialog)
{
    case SizeDialog.New:
        <SizePicker Title="New build" ConfirmLabel="Create"
                    Description="Starts an empty build. Ctrl+Z brings the current one back."
                    Initial="_editor.Build.Baseplate" OnConfirm="CreateNewBuild" OnCancel="CloseSizeDialog" />
        break;
    case SizeDialog.Resize:
        <SizePicker Title="Resize baseplate" ConfirmLabel="Resize"
                    Description="Grows or shrinks evenly around the centre, so parts keep their place."
                    Initial="_editor.Build.Baseplate" Error="@_sizeError" OnConfirm="ResizeBaseplate" OnCancel="CloseSizeDialog" />
        break;
}

@if (_nameDialog is { } dialog)
{
    <NameDialog Title="@dialog.Title" ConfirmLabel="@dialog.ConfirmLabel" Description="@dialog.Description"
                Initial="@dialog.Initial" OnConfirm="ConfirmName" OnCancel="() => _nameDialog = null" />
}

@code {
    private static readonly (string Keys, string Action)[] Controls =
    [
        ("Click", "place / paint / select"),
        ("Drag from panel", "place part or component"),
        ("Right-click · Del", "remove"),
        ("Shift+click", "move (whole selection if selected)"),
        ("Alt+click · E", "eyedropper"),
        ("R", "rotate"),
        ("B · P · S", "build · paint · select"),
        ("Drag", "box-select"),
        ("Ctrl+C · X · V", "copy · cut · paste"),
        ("Ctrl+A", "select all"),
        ("Esc", "cancel · deselect"),
        ("Ctrl+Z · Ctrl+Y", "undo · redo"),
        ("Right-drag", "orbit"),
        ("Middle-drag", "pan"),
        ("Wheel", "zoom"),
        ("F", "reset view"),
    ];

    private const long MaxImportBytes = 10 * 1024 * 1024;
    private static readonly TimeSpan AutosaveDelay = TimeSpan.FromSeconds(1);

    private enum SaveState { Loading, Saved, Pending, Failed }

    private enum SizeDialog { None, New, Resize }

    private sealed record Notice(string Text, bool IsError = false);

    private readonly Editor _editor = new(new Build(Baseplate.Default));
    private Notice? _notice;
    private SizeDialog _sizeDialog;
    private string? _sizeError;
    private SaveState _saveState = SaveState.Loading;
    private CancellationTokenSource? _pendingSave;

    private const int ThumbnailWidth = 160, ThumbnailHeight = 120;

    private readonly ComponentLibrary _library = new();
    /// <summary>Rendered on demand and kept in memory only, keyed by group (renaming keeps the picture).</summary>
    private readonly Dictionary<PartGroup, string> _thumbnails = [];
    private bool _libraryLoaded;
    private Viewport? _viewport;
    private NameDialogState? _nameDialog;
    private string? _confirmDeleteId;

    /// <param name="RenameId">The component being renamed; null when saving a new one.</param>
    private sealed record NameDialogState(string Title, string ConfirmLabel, string Initial, string? Description, string? RenameId);

    private string SaveStateText => _saveState switch
    {
        SaveState.Loading => "loading…",
        SaveState.Pending => "saving…",
        SaveState.Failed => "autosave failed",
        _ => "saved",
    };

    protected override void OnInitialized() => _editor.Changed += OnChanged;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _library.Changed += OnLibraryChanged;
        await RestoreAutosaveAsync();
        await LoadComponentsAsync();
    }

    private void OnChanged(BuildChange change)
    {
        // Autosave only once restoring has finished, and only for changes to the build itself.
        if (!change.IsEmpty && _saveState != SaveState.Loading) ScheduleAutosave();
        StateHasChanged();
    }

    // ---- autosave -----------------------------------------------------------------------------

    private async Task RestoreAutosaveAsync()
    {
        var json = await Storage.LoadAutosaveAsync();
        if (json is not null)
        {
            try
            {
                var loaded = BuildFile.Read(json);
                _editor.ReplaceAll(loaded.Baseplate, loaded.Parts);
                _editor.ForgetHistory();
            }
            catch (BuildFileException ex)
            {
                await Storage.SetAsideUnreadableAutosaveAsync(json);
                _notice = new Notice($"Couldn't restore the last session ({ex.Message}) It was kept aside in browser storage.", IsError: true);
            }
        }
        _saveState = SaveState.Saved;
        StateHasChanged();
    }

    private void ScheduleAutosave()
    {
        _pendingSave?.Cancel();
        _pendingSave = new CancellationTokenSource();
        _saveState = SaveState.Pending;
        _ = AutosaveAfterDelayAsync(_pendingSave.Token);
    }

    private async Task AutosaveAfterDelayAsync(CancellationToken token)
    {
        try
        {
            await Task.Delay(AutosaveDelay, token);
        }
        catch (OperationCanceledException)
        {
            return; // superseded by a newer change
        }
        var saved = await Storage.SaveAutosaveAsync(BuildFile.Write(_editor.Build));
        if (token.IsCancellationRequested) return;
        _saveState = saved ? SaveState.Saved : SaveState.Failed;
        StateHasChanged();
    }

    // ---- components ---------------------------------------------------------------------------

    private async Task LoadComponentsAsync()
    {
        var json = await Storage.LoadComponentsAsync();
        if (json is not null)
        {
            try
            {
                _library.Import(ComponentFile.Read(json));
            }
            catch (BuildFileException ex)
            {
                await Storage.SetAsideUnreadableComponentsAsync(json);
                _notice = new Notice($"Couldn't load your components ({ex.Message}) They were kept aside in browser storage.", IsError: true);
            }
        }
        _libraryLoaded = true;
        StateHasChanged();
        await RenderMissingThumbnailsAsync();
    }

    private void OnLibraryChanged()
    {
        if (_libraryLoaded) _ = SaveComponentsAsync();
        _ = RenderMissingThumbnailsAsync();
        StateHasChanged();
    }

    private async Task SaveComponentsAsync()
    {
        if (!await Storage.SaveComponentsAsync(ComponentFile.Write(_library.Components)))
        {
            _notice = new Notice("Couldn't save your components: browser storage is full or disabled. Export them to keep them.", IsError: true);
            StateHasChanged();
        }
    }

    private async Task RenderMissingThumbnailsAsync()
    {
        if (_viewport is null) return;
        foreach (var component in _library.Components.ToList())
        {
            if (_thumbnails.ContainsKey(component.Group)) continue;
            _thumbnails[component.Group] = await _viewport.RenderThumbnailAsync(component.Group, ThumbnailWidth, ThumbnailHeight);
            StateHasChanged();
        }
    }

    private void OpenSaveComponent()
    {
        if (_editor.Selection.Count == 0) return;
        _nameDialog = new NameDialogState(
            "Save as component", "Save", $"Component {_library.Components.Count + 1}",
            $"Saves the {Parts(_editor.Selection.Count)} you have selected so you can place them again from the panel.",
            RenameId: null);
    }

    private void OpenRenameComponent(Component component) =>
        _nameDialog = new NameDialogState("Rename component", "Rename", component.Name, null, component.Id);

    private void ConfirmName(string name)
    {
        if (_nameDialog?.RenameId is { } id)
        {
            _library.Rename(id, name);
        }
        else
        {
            var parts = _editor.Selection.Select(_editor.Build.Find).OfType<PlacedPart>().OrderBy(p => p.Id).ToList();
            if (parts.Count == 0) return;
            var component = _library.Add(name, PartGroup.From(parts));
            _notice = new Notice($"Saved {component.Name}. Click or drag it from Components to place it.");
        }
        _nameDialog = null;
    }

    private void DeleteComponent(string id)
    {
        _library.Delete(id);
        _confirmDeleteId = null;
    }

    private async Task ImportComponentsAsync(InputFileChangeEventArgs e)
    {
        try
        {
            string json;
            await using (var stream = e.File.OpenReadStream(MaxImportBytes))
            using (var reader = new StreamReader(stream))
            {
                json = await reader.ReadToEndAsync();
            }
            var count = _library.Import(ComponentFile.Read(json));
            _notice = new Notice($"Imported {count} component{(count == 1 ? "" : "s")} from {e.File.Name}.");
        }
        catch (BuildFileException ex)
        {
            _notice = new Notice($"Couldn't import {e.File.Name}: {ex.Message}", IsError: true);
        }
        catch (IOException)
        {
            _notice = new Notice($"Couldn't import {e.File.Name}: files over {MaxImportBytes / 1024 / 1024} MB aren't supported.", IsError: true);
        }
    }

    private async Task ExportComponentsAsync()
    {
        const string name = "brickforge-components.json";
        await Storage.DownloadAsync(name, ComponentFile.Write(_library.Components));
        var count = _library.Components.Count;
        _notice = new Notice($"Exported {count} component{(count == 1 ? "" : "s")} to {name}.");
    }

    // ---- files --------------------------------------------------------------------------------

    // ---- baseplate size -----------------------------------------------------------------------

    private void OpenSizeDialog(SizeDialog dialog) => (_sizeDialog, _sizeError) = (dialog, null);

    private void CloseSizeDialog() => _sizeDialog = SizeDialog.None;

    private void CreateNewBuild(Baseplate baseplate)
    {
        var hadParts = _editor.Build.Parts.Count > 0;
        _editor.NewBuild(baseplate);
        _notice = new Notice(hadParts
            ? $"Started a new {baseplate} build. Ctrl+Z brings the old one back."
            : $"Started a new {baseplate} build.");
        CloseSizeDialog();
    }

    private void ResizeBaseplate(Baseplate baseplate)
    {
        if (!_editor.Resize(baseplate))
        {
            _sizeError = $"Some parts wouldn't fit on {baseplate}. Move them towards the middle, or pick a bigger size.";
            return;
        }
        _notice = new Notice($"Baseplate is now {baseplate}. Ctrl+Z to undo.");
        CloseSizeDialog();
    }

    private async Task ImportAsync(InputFileChangeEventArgs e)
    {
        try
        {
            string json;
            await using (var stream = e.File.OpenReadStream(MaxImportBytes))
            using (var reader = new StreamReader(stream))
            {
                json = await reader.ReadToEndAsync();
            }
            var loaded = BuildFile.Read(json);
            _editor.ReplaceAll(loaded.Baseplate, loaded.Parts);
            _notice = new Notice($"Imported {e.File.Name} ({loaded.Parts.Count} parts on {loaded.Baseplate}). Ctrl+Z to undo.");
        }
        catch (BuildFileException ex)
        {
            _notice = new Notice($"Couldn't import {e.File.Name}: {ex.Message}", IsError: true);
        }
        catch (IOException)
        {
            _notice = new Notice($"Couldn't import {e.File.Name}: files over {MaxImportBytes / 1024 / 1024} MB aren't supported.", IsError: true);
        }
    }

    private async Task ExportAsync()
    {
        var name = $"brickforge-{DateTime.Now:yyyy-MM-dd-HHmm}.json";
        await Storage.DownloadAsync(name, BuildFile.Write(_editor.Build));
        _notice = new Notice($"Exported {name}.");
    }

    private static string? Active(bool active) => active ? "selected" : null;

    private static string Parts(int count) => count == 1 ? "1 part" : $"{count} parts";
    /// <summary>Top-down icon: the part's outline with a dot per stud (none for tiles).</summary>
    private static RenderFragment Footprint(PartType part) => builder =>
    {
        const double width = 34, height = 26, unit = width / 8; // fits 8 long by 6 wide
        var (w, d) = (part.Depth * unit, part.Width * unit);     // long side horizontal
        var (ox, oy) = ((width - w) / 2, (height - d) / 2);

        builder.OpenElement(0, "svg");
        builder.AddAttribute(1, "viewBox", $"0 0 {N(width)} {N(height)}");
        builder.AddAttribute(2, "class", "footprint");
        builder.OpenElement(3, "rect");
        builder.AddAttribute(4, "x", N(ox));
        builder.AddAttribute(5, "y", N(oy));
        builder.AddAttribute(6, "width", N(w));
        builder.AddAttribute(7, "height", N(d));
        builder.AddAttribute(8, "rx", "0.6");
        builder.CloseElement();
        if (part.HasStuds)
        {
            for (var i = 0; i < part.Depth; i++)
            for (var j = 0; j < part.Width; j++)
            {
                builder.OpenElement(9, "circle");
                builder.AddAttribute(10, "cx", N(ox + (i + 0.5) * unit));
                builder.AddAttribute(11, "cy", N(oy + (j + 0.5) * unit));
                builder.AddAttribute(12, "r", N(unit * 0.3));
                builder.CloseElement();
            }
        }
        builder.CloseElement();
    };

    private static string N(double v) => v.ToString("0.##", CultureInfo.InvariantCulture);

    public void Dispose()
    {
        _editor.Changed -= OnChanged;
        _library.Changed -= OnLibraryChanged;
        _pendingSave?.Cancel();
    }
}
